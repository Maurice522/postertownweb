# Browsers only use HTTPS for this site, plus basic security headers (pages get the
# same set from worker/index.js).
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Build files have a content hash in their name, so a changed file always gets a new
# URL: browsers can keep them for a year without checking again.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Site images change rarely: reuse them for a week, then check in the background.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The page itself must always be fresh so new deploys show up straight away.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
