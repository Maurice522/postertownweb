// Cloudflare Worker for metalpostertown.in: serves the React build (build/) and, for
// page requests, adds per-page SEO tags and real 404s (see worker/index.js).
// Deploy with `npm run deploy`.
{
  "name": "postertown-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    // Page requests go to the Worker; build files and images are served directly.
    "run_worker_first": ["/*", "!/static/*", "!/images/*"]
  },
  "vars": {
    "API_BASE_URL": "https://postertown-backend-v2.onrender.com",
    "SITE_URL": "https://metalpostertown.in"
  },
  // The site's DNS records are proxied by Cloudflare, so these routes send every
  // request for the domain to this Worker (www redirects to the bare domain).
  // Removing them sends traffic back to the records' origin (Netlify).
  "routes": [
    { "pattern": "metalpostertown.in/*", "zone_name": "metalpostertown.in" },
    { "pattern": "www.metalpostertown.in/*", "zone_name": "metalpostertown.in" }
  ],
  // Preview versions (`wrangler versions upload`) get their own test address so changes
  // can be checked before going live. The Worker marks those addresses noindex.
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
